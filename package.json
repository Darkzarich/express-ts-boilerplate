{
  "name": "express-ts-boilerplate",
  "version": "1.0.0",
  "description": "A boilerplate for Express + TS project",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "node index.ts",
    "start:dev:watch": "node --watch index.ts",
    "build": "tsc --project ./",
    "lint:types": "tsc --project ./ --noEmit && tsc --project ./test --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "boilerplate",
    "express",
    "typescript"
  ],
  "author": "Darkzarich",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
