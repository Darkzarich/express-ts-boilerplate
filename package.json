{
  "name": "express-ts-boilerplate",
  "version": "1.0.0",
  "description": "A boilerplate for Express + TS project",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "tsx index.ts",
    "start:dev:watch": "tsx watch index.ts",
    "build": "tsc --project ./",
    "lint:types": "tsc --project ./ --noEmit && tsc --project ./test --noEmit",
    "test": "jest"
  },
  "keywords": [
    "boilerplate",
    "express",
    "typescript"
  ],
  "author": "Darkzarich",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
