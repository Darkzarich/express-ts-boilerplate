{
  "name": "express-ts-boilerplate",
  "version": "1.0.0",
  "description": "A boilerplate for Express + TypeScript projects",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "node --env-file-if-exists=.env index.ts",
    "start:dev:watch": "node --env-file-if-exists=.env --watch index.ts",
    "build": "tsc --project ./",
    "lint:types": "tsc --project ./ --noEmit && tsc --project ./test --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "npm run format:check && npm run lint && npm run lint:types && npm test"
  },
  "keywords": [
    "boilerplate",
    "express",
    "typescript"
  ],
  "author": "Darkzarich",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "private": true
}
